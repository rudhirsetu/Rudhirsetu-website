# Copy to .env.local for local development. On Vercel, set these in Project Settings -> Environment Variables.

# Sanity (public: read-only CDN access to published content)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-03-14

# Canonical site origin, no trailing slash. Used for canonical URLs, sitemap links and
# absolute og:image URLs. Locally: http://localhost:3000. Production: https://www.rudhirsetu.org
# (falls back to https://www.rudhirsetu.org when unset).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Shared secret for the Sanity webhook -> /api/revalidate (send it as the `x-sanity-secret` header).
# Generate a long random string; requests without the matching secret are rejected.
SANITY_REVALIDATE_SECRET=replace-with-a-long-random-string

# Optional: show the slim "development build" bar at the bottom of the page.
NEXT_PUBLIC_SHOW_DEV_WARNING=false
